# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; .env.example is checked in.

# --- Clerk auth (Phase A) ---
# Provision at https://dashboard.clerk.com → Create application
# Use the "Development" instance keys. Publishable key is safe to expose; secret key is not.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Route overrides — defaults already point here, but Clerk reads them at runtime
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Neon Postgres (Phase B — uncomment when Phase B lands) ---
# Provision at https://console.neon.tech → New project
# Use the pooled connection string for serverless route handlers.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
